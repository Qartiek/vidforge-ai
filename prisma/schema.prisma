generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  passwordHash String
  sessions    Session[]
  passwordResetTokens PasswordResetToken[]
  role        Role     @default(USER)
  plan        Plan     @default(FREE)
  credits     Int      @default(0)
  createdAt   DateTime @default(now())
  projects    Project[]
  jobs        Job[]
  auditLogs   AuditLog[]
  youtube     YouTubeConnection?
  publishes   YouTubePublish[]
  analytics   YouTubeAnalytics[]
  automationProfiles AutomationProfile[]
  automationRuns AutomationRun[]
  contentCalendar ContentCalendar[]
  socialConnections SocialConnection[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Project {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  topic      String
  status     ProjectStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  jobs       Job[]
  sources    ResearchSource[]
  findings   ResearchFinding[]
  scripts    ContentScript[]
  assets     MediaAsset[]
  publishes  YouTubePublish[]
  analytics  YouTubeAnalytics[]
  automationRuns AutomationRun[]
  contentCalendar ContentCalendar[]
}

model ResearchSource {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  publisher   String?
  fetchedAt   DateTime @default(now())
  contentHash String?
  content     String   @db.Text
  @@unique([projectId, url])
  @@index([projectId, fetchedAt])
}

model ResearchFinding {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceId   String?
  claim      String
  evidence   String
  confidence Float    @default(0)
  createdAt  DateTime @default(now())
  @@index([projectId, createdAt])
  @@index([sourceId])
}

model ContentScript {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hook        String
  title       String
  script      String   @db.Text
  seoTitle    String
  description String   @db.Text
  tagsJson    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaAsset {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String
  url        String
  provider   String
  mimeType   String?
  sceneIndex Int?
  duration   Float?
  metadata   String?
  createdAt  DateTime @default(now())
  @@index([projectId, sceneIndex])
}

model Job {
  id             String    @id @default(cuid())
  userId         String
  projectId      String?
  previousJobId  String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           String
  status         JobStatus @default(QUEUED)
  payload        String
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  @@unique([previousJobId, type])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  resourceId String?
  success    Boolean  @default(true)
  ip         String?
  metadata   String?
  createdAt  DateTime @default(now())
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model RateLimit {
  id      String   @id
  key     String
  bucket  DateTime
  count   Int      @default(0)
  @@index([key, bucket])
}

model YouTubeConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId    String?
  channelTitle String?
  accessToken  String?
  refreshToken String
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialConnection {
  id           String   @id @default(cuid())
  userId       String
  provider     SocialProvider
  accountId    String
  accountName  String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String?
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider, accountId])
  @@index([userId, provider])
}

model YouTubePublish {
  id             String        @id @default(cuid())
  userId         String
  projectId      String?
  idempotencyKey String
  youtubeVideoId String?
  status         PublishStatus @default(QUEUED)
  title          String
  description    String?
  tagsJson       String?
  privacyStatus  String        @default("private")
  scheduledAt    DateTime?
  assetRef       String
  error          String?
  createdAt      DateTime      @default(now())
  publishedAt    DateTime?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analytics      YouTubeAnalytics[]
  calendarItems  ContentCalendar[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, scheduledAt])
}

model YouTubeAnalytics {
  id                          String         @id @default(cuid())
  userId                      String
  projectId                   String?
  publishId                   String
  youtubeVideoId              String
  views                       Int            @default(0)
  likes                       Int            @default(0)
  comments                    Int            @default(0)
  watchTimeMinutes            Float          @default(0)
  averageViewDurationSeconds  Float          @default(0)
  averageViewPercentage      Float            @default(0)
  recommendationsJson        String?
  fetchedAt                  DateTime       @default(now())
  user                       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                    Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  publish                    YouTubePublish @relation(fields: [publishId], references: [id], onDelete: Cascade)
  @@index([userId, fetchedAt])
  @@index([publishId, fetchedAt])
}

model AutomationProfile {
  id              String   @id @default(cuid())
  userId          String
  name            String   @default("Default AutoPilot")
  enabled         Boolean  @default(false)
  niche           String
  audience        String
  language        String   @default("English")
  cadence         String   @default("weekly")
  publishHourUtc  Int      @default(12)
  videosPerRun    Int      @default(1)
  autoPublish     Boolean  @default(false)
  privacyStatus   String   @default("private")
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs            AutomationRun[]
  @@index([userId, enabled])
  @@index([enabled, nextRunAt])
}

model AutomationRun {
  id            String   @id @default(cuid())
  userId        String
  profileId     String
  projectId     String?
  status        AutomationRunStatus @default(QUEUED)
  topic         String?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile       AutomationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([profileId, createdAt])
}

model ContentCalendar {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  publishId   String?
  scheduledAt DateTime
  status      CalendarStatus @default(PLANNED)
  title       String
  topic       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  publish     YouTubePublish? @relation(fields: [publishId], references: [id], onDelete: SetNull)
  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
}

enum SocialProvider {
  META
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  X
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum ProjectStatus {
  DRAFT
  QUEUED
  RESEARCHING
  SCRIPTING
  PRODUCING
  COMPLETE
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum PublishStatus {
  QUEUED
  UPLOADING
  PUBLISHED
  FAILED
}

enum AutomationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum CalendarStatus {
  PLANNED
  IN_PROGRESS
  PUBLISHED
  CANCELLED
}
